theme2_calc = rowMeans(across(c(AGE65_r, AGE17_r, DISABL_r, SNGPNT_r, LIMENG_r))),
theme3_calc = MINRTY_r,
theme4_calc = rowMeans(across(c(MUNIT_r, MOBILE_r, CROWD_r, NOVEH_r, GROUPQ_r))),
total_calc  = rowMeans(across(all_of(rank_cols)))
) %>%
left_join(svi %>% select(GEOID, RPL_THEME1, RPL_THEME2, RPL_THEME3, RPL_THEME4, RPL_THEMES), by = "GEOID")
